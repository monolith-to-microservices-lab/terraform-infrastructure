# Copy to terraform.tfvars (git-ignored). Account/person-specific values only.
# NEVER put passwords or AWS keys here: DB passwords are generated by Terraform
# (write-only, not in state) and AWS credentials come from your AWS profile.

# REQUIRED. Must match the region of the state bucket (bootstrap).
aws_region = "us-east-1"

# REQUIRED. Who can reach the ALB. Your public IP: (Invoke-RestMethod https://checkip.amazonaws.com).Trim() + "/32"
allowed_ingress_cidrs = ["203.0.113.10/32"]

# Optional: allow the migration-tool (running from your machine) to call /internal/*.
internal_api_allowed_cidrs = []

# Output of bootstrap: workload_permissions_boundary_arn
# permissions_boundary_arn = "arn:aws:iam::123456789012:policy/mtm-workload-boundary"

# alarm_emails = ["you@example.com"]
